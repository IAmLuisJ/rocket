{
  "name": "rocket-cli",
  "version": "0.1.0",
  "description": "Bootstrap projects and run AI development loops from the terminal",
  "type": "module",
  "bin": {
    "rocket": "./dist/bin/rocket.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp package.json dist/package.json",
    "clean": "rm -rf dist/",
    "dev": "tsx watch bin/rocket.ts",
    "start": "node dist/bin/rocket.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ bin/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "bin/",
    "templates/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "scaffold",
    "ai",
    "loop",
    "rocket"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.3.1",
    "strip-ansi": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^2.0.5",
    "esbuild-wasm": "^0.27.4",
    "eslint": "^9.17.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.57.1",
    "vitest": "^2.0.5"
  }
}
