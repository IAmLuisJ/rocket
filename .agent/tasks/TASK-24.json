{
  "id": "TASK-24",
  "title": "Add webapp template: composite tsconfig files",
  "category": "functional",
  "description": "Create TypeScript configuration files for both the client and server templates. The client uses a composite tsconfig setup (base, app, node configs). The server uses NodeNext module resolution.",
  "acceptanceCriteria": [
    "src/templates/webapp/client/tsconfig.json exists",
    "src/templates/webapp/client/tsconfig.app.json exists",
    "src/templates/webapp/client/tsconfig.node.json exists",
    "src/templates/webapp/server/tsconfig.json exists",
    "Server tsconfig uses NodeNext module resolution",
    "Client tsconfig.app.json includes @/* path alias"
  ],
  "steps": [
    {
      "step": 1,
      "description": "Create client base tsconfig.json",
      "details": "Create src/templates/webapp/client/tsconfig.json: { \"files\": [], \"references\": [{ \"path\": \"./tsconfig.app.json\" }, { \"path\": \"./tsconfig.node.json\" }] }. This is the composite root.",
      "pass": false
    },
    {
      "step": 2,
      "description": "Create client tsconfig.app.json",
      "details": "Create tsconfig.app.json: { \"compilerOptions\": { \"target\": \"ES2022\", \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"], \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\", \"jsx\": \"react-jsx\", \"strict\": true, \"baseUrl\": \".\", \"paths\": { \"@/*\": [\"./src/*\"] } }, \"include\": [\"src\"] }",
      "pass": false
    },
    {
      "step": 3,
      "description": "Create client tsconfig.node.json",
      "details": "Create tsconfig.node.json for vite.config.ts: { \"compilerOptions\": { \"target\": \"ES2022\", \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\", \"allowSyntheticDefaultImports\": true }, \"include\": [\"vite.config.ts\"] }",
      "pass": false
    },
    {
      "step": 4,
      "description": "Create server tsconfig.json",
      "details": "Create src/templates/webapp/server/tsconfig.json: { \"compilerOptions\": { \"target\": \"ES2022\", \"module\": \"NodeNext\", \"moduleResolution\": \"NodeNext\", \"outDir\": \"dist\", \"rootDir\": \"src\", \"strict\": true, \"declaration\": true }, \"include\": [\"src\"] }",
      "pass": false
    }
  ],
  "dependencies": ["TASK-19"],
  "estimatedComplexity": "low",
  "technicalNotes": [
    "Client uses Bundler moduleResolution (for Vite) while server uses NodeNext — they require different settings",
    "The composite tsconfig pattern is standard for Vite projects generated by create-vite"
  ]
}
